<http://lod-cloud.net/dataset/WordFormationLatin>
        a                    void:Dataset ;
        dcterms:description  "Word Formation Latin is a derivational lexicon for Latin. This dataset is linked to the LiLa Knowledge Base"@en ;
        dcterms:publisher    [ rdfs:label  "Marco Passarotti" ;
                               foaf:mbox   "marco.passarotti@unicatt.it"
                             ] ;
        dcterms:subject      "LLOD" , "linguistics" , "LiLa" , "Lexicon" , "Latin" , "Derivational Morphology" ;
        dcterms:title        "Word Formation Latin (WFL) in LiLa"@en ;
        void:dataDump        <https://github.com/CIRCSE/WFL> ;
        void:sparqlEndpoint  <https://lila-erc.eu/sparql/lila_knowledge_base/sparql> ;
        void:triples         508372 ;
        foaf:homepage        <https://lila-erc.eu/data/lexicalResources/WFL/Lexicon> .
