<http://lod-cloud.net/dataset/Water_Buffer>
        a                    void:Dataset ;
        dcterms:description  "This data contains the water buffer and water body related data from Czech republic. The source data was in shapefiles which is transformed into linked data."@en ;
        dcterms:publisher    [ rdfs:label  "Raul Palma, Soumya Brahma" ;
                               foaf:mbox   "rpalma@man.poznan.pl"
                             ] ;
        dcterms:subject      "czech republic" , "water bodies" , "water buffer zones" , "geography" , "agriculture" ;
        dcterms:title        "Water buffer dataset from Czech Republic @PSNC"@en ;
        void:sparqlEndpoint  <https://www.foodie-cloud.org/sparql> ;
        void:triples         3978517 ;
        foaf:homepage        <https://www.foodie-cloud.org/fct/> .
