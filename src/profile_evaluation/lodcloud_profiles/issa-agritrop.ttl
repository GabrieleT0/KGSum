<http://lod-cloud.net/dataset/issa-agritrop>
        a                     void:Dataset ;
        dcterms:description   "This dataset, produced in the context of the ISSA project (https://issa.cirad.fr/), provides a semantic index of the articles of the Agritrop scientific archive. It is built by extracting thematic descriptors and named entities from the articles full-text, and linking them with resources from DBpedia, Wikidata and AGROVOC."@en ;
        dcterms:publisher     [ rdfs:label  "Franck MICHEL" ;
                                foaf:mbox   "franck.michel@inria.fr"
                              ] ;
        dcterms:subject       "life_sciences" ;
        dcterms:title         "ISSA Agritrop Dataset"@en ;
        void:dataDump         <https://doi.org/10.5281/zenodo.6505847> ;
        void:exampleResource  <https://github.com/issa-project/issa-pipeline/tree/main/doc/examples> ;
        void:sparqlEndpoint   <http://issa.i3s.unice.fr/sparql> ;
        void:triples          66051026 ;
        foaf:homepage         <https://github.com/issa-project/issa-pipeline> .

