<http://lod-cloud.net/dataset/LemmaBank>
        a                     void:Dataset ;
        dcterms:description   "The Lemma Bank is a collection of approximately 200,000 canonical forms for Latin that is used to interlink the linguistic resources in the LiLa Knowledge Base. The canonical forms are modeled using the Ontolex ontology."@en ;
        dcterms:publisher     [ rdfs:label  "Marco Passarotti" ;
                                foaf:mbox   "marco.passarotti@unicatt.it"
                              ] ;
        dcterms:subject       "Lexicon" , "linguistics" , "Lemma" , "Canonical forms" , "Latin" , "LiLa" , "LLOD" ;
        dcterms:title         "LiLa Lemma Bank"@en ;
        void:dataDump         <https://github.com/CIRCSE/LiLa_Lemma-Bank> ;
        void:exampleResource  <http://lila-erc.eu/data/id/lemma/88717> ;
        void:sparqlEndpoint   <https://lila-erc.eu/sparql/lila_knowledge_base/sparql> ;
        void:triples          1699687 ;
        dcat:distribution     [ dcat:accessURL  <https://lila-erc.eu/lodview/data/id/lemma/LemmaBank?output=application%2Frdf%2Bxml> ] ;
        foaf:homepage         <http://lila-erc.eu/data/id/lemma/LemmaBank> .

