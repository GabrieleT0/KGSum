@prefix void:    <http://rdfs.org/ns/void#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<http://lod-cloud.net/dataset/EtymologicalDictionaryofLatin>
        a                    void:Dataset ;
        dcterms:description  "New etymological dictionary by Brill that covers the entire Latin lexicon of Indo-European origin. It consists of nearly 1900 entries, which altogether discuss about 8000 Latin lemmata. Only some information about P-I.E. and Proto-Italic roots is accessible via the LiLa Knowledge Base."@en ;
        dcterms:publisher    [ rdfs:label  "Marco Passarotti" ;
                               foaf:mbox   "marco.passarotti@unicatt.it"
                             ] ;
        dcterms:subject      "Lexicon" , "Latin" , "LLOD" , "Etymology" , "LiLa" , "linguistics" ;
        dcterms:title        "Etymological Dictionary of Latin in LiLa"@en ;
        void:dataDump        <https://github.com/CIRCSE/EtymologicalDictionaryLatin> ;
        void:sparqlEndpoint  <https://lila-erc.eu/sparql/lila_knowledge_base/sparql> ;
        void:triples         57519 ;
        foaf:homepage        <http://lila-erc.eu/data/lexicalResources/BrillEDL/Lexicon> .

[ void:target   <http://lod-cloud.net/dataset/LemmaBank> , <http://lod-cloud.net/dataset/EtymologicalDictionaryofLatin> ;
  void:triples  1452
] .
