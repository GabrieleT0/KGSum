@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<http://lod-cloud.net/dataset/LatinAffectus>
        a                    void:Dataset ;
        dcterms:description  "Sentiment lexicons linked to the LiLa Knowledge Base. Gold: prior polarity lexicon of Latin lemmas created by two experts of Latin language and culture following a multi-stage process and an extensive reconciliation phase. It follows a five-way classification: 1 (fully positive), 0.5 (somewhat positive), 0 (neutral), -0.5 (somewhat negative), -1 (fully negative) Silver: prior polarity lexicon built by deriving new entries through synonym, antonym and derivational relations with the entries in the gold standard."@en ;
        dcterms:publisher    [ rdfs:label  "Marco Passarotti" ;
                               foaf:mbox   "marco.passarotti@unicatt.it"
                             ] ;
        dcterms:subject      "Sentiment" , "LiLa" , "Lexicon" , "LLOD" , "Latin" , "linguistics" ;
        dcterms:title        "LatinAffectus in LiLa"@en ;
        void:dataDump        <https://github.com/CIRCSE/Latin_Sentiment_Lexicons> ;
        void:sparqlEndpoint  <https://lila-erc.eu/sparql/lila_knowledge_base/sparql> ;
        void:triples         46571 ;
        foaf:homepage        <http://lila-erc.eu/data/lexicalResources/LatinAffectus/Lexicon> .

[ void:target   <http://lod-cloud.net/dataset/LemmaBank> , <http://lod-cloud.net/dataset/LatinAffectus> ;
  void:triples  5172
] .
