<http://lod-cloud.net/dataset/orkg>
        a                    void:Dataset ;
        dcterms:description  "The Open Research Knowledge Graph (ORKG) is a community initiative aimed at extracting structured information from research publications and making this information accessible on the Web. ORKG enables users to perform sophisticated queries against research information and to link other datasets and software on the Web to research publications in the ORKG.\n\nThe ORKG knowledge base currently describes 33,619 research publications,  5304 datasets, and 1423 software with a total of 1.6M statements, almost 500,000 resources, and over 800,000 literals. It provides detailed metadata, such as authors, venues, publication year, and citations. The ORKG is a comprehensive and interconnected knowledge graph. This structured data allows for advanced querying capabilities and facilitates the integration of research data with other web resources.\n\nFor thorough statistics and general information on the ORKG datasets, please visit the ORKG website."@en ;
        dcterms:publisher    [ rdfs:label  "ORKG Curation & Community Building Team" ;
                               foaf:mbox   "curation@orkg.org"
                             ] ;
        dcterms:subject      "publication" , "research" , "publications" , "dataset" , "access-api" , "software" , "sparql-endpoint" , "rdf" ;
        dcterms:title        "Open Research Knowledge Graph (ORKG)"@en ;
        void:dataDump        <https://orkg.org/api/rdf/dump> ;
        void:sparqlEndpoint  <https://orkg.org/triplestore> ;
        void:triples         1631808 ;
        foaf:homepage        <https://orkg.org/> .

[ void:target   <http://lod-cloud.net/dataset/wikidata> , <http://lod-cloud.net/dataset/orkg> ;
