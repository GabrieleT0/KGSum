        a                    void:Dataset ;
        dcterms:description  "The Index Thomisticus Treebank linked to the LiLa Knowledge Base is a corpus that contains Latin texts of Thomas Aquinas (Medieval Latin) enhanced with complex and interlinked morphological, syntactic and semantic/pragmatic annotation.\n"@en ;
        dcterms:publisher    [ rdfs:label  "Marco Passarotti" ;
                               foaf:mbox   "marco.passarotti@unicatt.it"
                             ] ;
        dcterms:subject      "Latin" , "LiLa" , "Corpus" , "linguistics" , "Thomas Aquinas" , "LLOD" ;
        dcterms:title        "Index Thomisticus Treebank in LiLa"@en ;
        void:dataDump        <https://github.com/CIRCSE/IT-TB> ;
        void:sparqlEndpoint  <https://lila-erc.eu/sparql/lila_knowledge_base/sparql> ;
        void:triples         9937227 ;
        foaf:homepage        <http://lila-erc.eu/data/corpora/ITTB/id/corpus> .

