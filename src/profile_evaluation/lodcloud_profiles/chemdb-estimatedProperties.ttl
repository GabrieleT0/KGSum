<http://lod-cloud.net/dataset/chemdb-estimatedProperties>
        a                    void:Dataset ;
        dcterms:description  "This dataset collects information on the estimated properties of compounds, including ALogP,ALogP_MR, Minimized_Energy,et. al. via the law of corresponding states (LCS), the method of group contributions (GC), and the like."@en ;
        dcterms:publisher    [ rdfs:label  "赵月红" ;
                               foaf:mbox   "yhzhao@ipe.ac.cn"
                             ] ;
        dcterms:subject      "compound" , "estimated  properties" , "LCS" , "life_sciences" , "GC" ;
        dcterms:title        "chemdb estimated properties dataset"@en ;
        void:sparqlEndpoint  <http://chemdb.semweb.csdb.cn/sparql> ;
        void:triples         6113040 ;
        foaf:homepage        <http://chemdc.casdc.cn/> .

