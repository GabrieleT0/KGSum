<http://lod-cloud.net/dataset/chemdb-thermochemistry>
        a                    void:Dataset ;
        dcterms:description  "This dataset collects information on the thermochemical properties and basic physicochemical properties of compounds at gaseous state and condensed state, including heat capacity, standard entropy and standard enthalpy, et. al."@en ;
        dcterms:publisher    [ rdfs:label  "赵月红" ;
                               foaf:mbox   "yhzhao@ipe.ac.cn"
                             ] ;
        dcterms:subject      "compound" , "life_sciences" , "thermochemical properties" , "physicochemical properties" ;
        dcterms:title        "chemdb thermochemistry dataset"@en ;
        void:sparqlEndpoint  <http://chemdb.semweb.csdb.cn/sparql> ;
        void:triples         42003 ;
        foaf:homepage        <http://chemdc.casdc.cn/> .
